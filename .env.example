# =========================================================================
# INSIDE ENGLISH v2.0 - PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local for local Next.js development
# =========================================================================

# 1. SUPABASE (DATABASE & STORAGE)
# Found on Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Required on Next.js server/Edge Functions (REVENUECAT / AUTO-ADMIN TASK ACTIONS)
# Found on Supabase Dashboard -> Project Settings -> API -> service_role (SECRET)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. TELEGRAM MINI APP (BOT API)
# Acquired from @BotFather when initializing your bot
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ...

# 3. SPEECH EVALUATION & CHAT ENGINE (OPENAI / OPENROUTER)
# Required for Whisper Speech-To-Text translation inside shadowing route
OPENAI_API_KEY=sk-proj-abc123XYZ...

# Required for OpenRouter LLM Aggregator (supports GPT-4o, Claude 3.5 Sonnet, etc.)
OPENROUTER_API_KEY=sk-or-v1-abc123XYZ...
NEXT_PUBLIC_OPENROUTER_MODEL=openai/gpt-4o


# 4. IN-APP PURCHASES & BILLING (REVENUECAT WEBHOOKS)
# Shared auth token configured inside RevenueCat webhook settings to secure Edge Functions
REVENUECAT_WEBHOOK_SECRET=your_custom_secure_webhook_passphrase

# 5. PUSH NOTIFICATIONS & CRON REMINDERS (GOOGLE FIREBASE FCM)
# Required for daily-reminder Edge Function to dispatch FCM messages
FIREBASE_PROJECT_ID=inside-english-fcm
FCM_SERVICE_ACCOUNT_JWT=your_google_oauth2_bearer_jwt_token
CRON_SECRET=your_cron_schedule_authorized_token

# 6. TELEGRAM WEBHOOK (STARS BILLING SECURITY)
# Secret token configured during Bot setWebhook to authenticate Telegram requests securely
TELEGRAM_WEBHOOK_SECRET_TOKEN=your_highly_secure_webhook_secret_token_phrase

